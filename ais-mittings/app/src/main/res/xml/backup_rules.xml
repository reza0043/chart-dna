<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Never back up the encrypted per-advisor-slot API key store, or the Room database
         that holds session transcripts / advisor metadata (subAgentsJson no longer
         contains API keys, but the transcripts themselves may be sensitive). -->
    <exclude domain="sharedpref" path="boardroom_secure_keys.xml"/>
    <exclude domain="database" path="boardroom_database.db"/>
</full-backup-content>
