# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# OPENAI_API_KEY / ANTHROPIC_API_KEY: optional app-wide fallback keys used
# when an advisor sub-agent slot's modelType resolves to that provider
# (e.g. "gpt-4o", "claude-3-5-sonnet-20241022") and the slot has no
# customApiKey of its own set in the app UI.
OPENAI_API_KEY=MY_OPENAI_API_KEY
ANTHROPIC_API_KEY=MY_ANTHROPIC_API_KEY
